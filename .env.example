# API Keys - Copy this file to .env and fill in your actual keys
# .env is listed in .gitignore and will NOT be committed to version control

# AcoustID API key - https://acoustid.org/
ACOUST_ID=your_acoustid_api_key_here

# Genius API access token - https://genius.com/api-clients
GENIUS_API_ACCESS_TOKEN=your_genius_api_token_here

# Google Gemini API key - https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
